{
  "name": "tsconfig",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "ready": "vp run check --fix && vp run test && vp run build",
    "dev": "vp run docs#dev",
    "clean": "vp run -r clean && git clean -xdf node_modules dist .output",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.8.0"
}
