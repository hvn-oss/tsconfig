{
  "name": "@hvn-oss/tsconfig",
  "version": "0.0.4",
  "description": "Shared TypeScript configuration presets for HVN OSS projects.",
  "homepage": "https://github.com/hvn-oss/tsconfig#readme",
  "bugs": {
    "url": "https://github.com/hvn-oss/tsconfig/issues"
  },
  "license": "MIT",
  "author": "Daniel Fakunle <danielofakunle@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "github:hvn-oss/tsconfig",
    "directory": "packages/tsconfig"
  },
  "files": [
    "*.json"
  ],
  "type": "module",
  "exports": {
    "./bun": "./bun.json",
    "./bun.json": "./bun.json",
    "./library": "./library.json",
    "./library.json": "./library.json",
    "./node-library": "./node-library.json",
    "./node-library.json": "./node-library.json",
    "./package.json": "./package.json",
    "./react-library": "./react-library.json",
    "./react-library.json": "./react-library.json",
    "./vite": "./vite.json",
    "./vite.json": "./vite.json",
    "./vp-react-library": "./vp-react-library.json",
    "./vp-react-library.json": "./vp-react-library.json",
    "./vp-vite": "./vp-vite.json",
    "./vp-vite.json": "./vp-vite.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf node_modules dist .output",
    "test": "node --test test/*.test.mjs && tsc -p test/fixtures/bun/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
